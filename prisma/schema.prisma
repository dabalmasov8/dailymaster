generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String   @id @default(cuid())
  clerkId                String   @unique
  teamMembers            Json     @default("[]")
  questions              Json     @default("[{\"id\":\"default-1\",\"text\":\"What will I do today?\"},{\"id\":\"default-2\",\"text\":\"Do I have blockers for today?\"},{\"id\":\"default-3\",\"text\":\"Do I have capacity today to help others?\"}]")
  newcomerIntroQuestions Json     @default("[{\"id\":\"default-1\",\"text\":\"Your name\"},{\"id\":\"default-2\",\"text\":\"Your role\"},{\"id\":\"default-3\",\"text\":\"Are you a morning person?\"},{\"id\":\"default-4\",\"text\":\"Should pineapple be allowed on pizza?\"}]")
  standupDurationMinutes Int      @default(2)
  standupDurationSeconds Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  standupSessions StandupSession[]
  blockers        Blocker[]
  capacityOffers  CapacityOffer[]
  apiTokens       ApiToken[]
}

model ApiToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  tokenHash     String    @unique
  tokenPrefix   String
  oauthClientId String? // set when this token was minted via the OAuth flow rather than Settings
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  @@index([userId])
}

// A client application registered via Dynamic Client Registration (RFC 7591),
// e.g. Claude.ai registering itself the first time a user connects.
model OAuthClient {
  id           String   @id @default(cuid()) // this is the OAuth client_id
  clientName   String?
  redirectUris Json // string[]
  createdAt    DateTime @default(now())
}

// Short-lived authorization code, exchanged once at /oauth/token.
model OAuthCode {
  code                String   @id @default(cuid())
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String   @default("S256")
  scope               String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
}

model StandupSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  orderMode   String // "default" | "shuffled"
  // [{ memberId, name, present, allottedSeconds, usedSeconds }]
  participants Json     @default("[]")

  blockers       Blocker[]
  capacityOffers CapacityOffer[]

  @@index([userId, startedAt])
}

model Blocker {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        StandupSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  memberId       String
  memberName     String
  note           String          @default("")
  status         String          @default("new") // "new" | "in_progress" | "resolved" | "wont_fix"
  reportedAt     DateTime        @default(now())
  resolvedAt     DateTime?
  resolutionNote String          @default("")

  comments BlockerComment[]

  @@index([userId, status])
}

model BlockerComment {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Blocker  @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([blockerId])
}

model CapacityOffer {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    StandupSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  memberId   String
  memberName String
  reportedAt DateTime        @default(now())
  claimed    Boolean         @default(false)
  claimedAt  DateTime?

  @@index([userId, claimed])
}
